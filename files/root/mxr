#!/bin/sh
. /usr/lib/mxc
TARGET="$1"
case "$TARGET" in wds | repeater) ;; *) exit 1 ;; esac
date +%s >/tmp/mxauto-manual
WAN_PORT=wan
WAN_PREF=wifi
if [ "$TARGET" = repeater ]; then
    while true; do
        printf 'WAN socket: 1=client LAN port 2=wired uplink [2]: '
        read -r answer || exit 1
        case "$answer" in 1)
            WAN_PORT=lan
            break
            ;;
        '' | 2) break ;; esac
    done
    if [ "$WAN_PORT" = wan ]; then
        echo 'Routed uplinks use mwan3 Internet probes; route metrics prefer healthy links.'
        while true; do
            printf 'Preferred uplink: 1=wired WAN 2=Wi-Fi repeater [2]: '
            read -r answer || exit 1
            case "$answer" in '' | 2) break ;; 1)
                WAN_PREF=wan
                break
                ;;
            esac
        done
    fi
fi
scan_band() {
    radio=$1
    L=$2
    MATCH_SSID=${3:-}
    REUSE_PASS=${4:-}
    temporary_file=/tmp/mx4200-scan.$$
    echo
    echo "Scanning $L..."
    scan_radio "$radio" "$temporary_file" || {
        rm -f "$temporary_file"
        echo "$L scan failed (4 passes)."
        return 1
    }
    TAB="$(printf '\t')"
    LINE=''
    if [ -n "$MATCH_SSID" ]; then
        while IFS= read -r ROW; do
            [ "${ROW%%"$TAB"*}" = "$MATCH_SSID" ] && {
                LINE="$ROW"
                break
            }
        done <"$temporary_file"
        [ -n "$LINE" ] || {
            rm -f "$temporary_file"
            echo "$MATCH_SSID not found on $L."
            return 1
        }
    else
        iteration=0
        while IFS="$TAB" read -r section choice G encryption bridge_section; do
            iteration=$((iteration + 1))
            printf '%2d) %s  [ch %s, %s dBm, %s, %s]\n' "$iteration" "$section" "$choice" "$G" "$encryption" "$bridge_section"
        done <"$temporary_file"
        while true; do
            printf 'Select network number (0 = rescan): '
            read -r value || {
                rm -f "$temporary_file"
                return 1
            }
            [ "$value" = 0 ] && {
                rm -f "$temporary_file"
                return 2
            }
            case "$value" in *[!0-9]* | '') continue ;; esac
            LINE="$(sed -n "${value}p" "$temporary_file")"
            [ -n "$LINE" ] && break
        done
    fi
    IFS="$TAB" read -r SEL_SSID SEL_CHANNEL _ SEL_ENC_TEXT SEL_BSSID <<EOT
$LINE
EOT
    SEL_ENC="$(scan_encryption_to_uci "$SEL_ENC_TEXT")"
    rm -f "$temporary_file"
    [ "$SEL_ENC" != unsupported ] || {
        echo "Unsupported: $SEL_ENC_TEXT"
        return 1
    }
    SEL_PASS=''
    case "$SEL_ENC" in
        psk)
            echo "Scan reports $SEL_ENC_TEXT for $SEL_BSSID (WPA1). Check router setting."
            while true; do
                printf 'Actual upstream: 1=WPA2-PSK 2=WPA1-PSK (no default): '
                read -r ESEL || return 1
                case "$ESEL" in 1)
                    SEL_ENC=psk2
                    break
                    ;;
                2)
                    SEL_ENC=psk
                    break
                    ;;
                *) echo 'Choose 1 or 2.' ;; esac
            done
            ;;
    esac
    case "$SEL_ENC" in none | owe | psk | psk-mixed)
        echo 'Backhaul requires authenticated WPA2/WPA3; open/OWE/WPA1 is refused.'
        return 1
        ;;
    esac
    if [ -n "$MATCH_SSID" ] && [ -n "$REUSE_PASS" ] && ! encryption_needs_key "$SEL_ENC"; then
        echo "$L network has no password; choose it separately."
        return 1
    fi
    if encryption_needs_key "$SEL_ENC"; then
        if [ -n "$MATCH_SSID" ]; then
            SEL_PASS="$REUSE_PASS"
        else
            read_secret "Upstream Wi-Fi password for $SEL_SSID: "
            SEL_PASS="$SECRET"
        fi
        [ -n "$SEL_PASS" ] || {
            echo 'Password required'
            return 1
        }
    fi
}
uci -q get network.usbwan >/dev/null 2>&1 && /usr/sbin/mxu off-quiet
save_current_profile
RD="$PROFILE_ROOT/router"
R_LAN_IP="$(uci -c "$RD" -q get network.lan.ipaddr 2>/dev/null)"
[ -n "$R_LAN_IP" ] || R_LAN_IP="$LAN_IP"
R_LAN_NETMASK="$(uci -c "$RD" -q get network.lan.netmask 2>/dev/null)"
[ -n "$R_LAN_NETMASK" ] || R_LAN_NETMASK="$LAN_NETMASK"
R_DHCP_START="$(uci -c "$RD" -q get dhcp.lan.start 2>/dev/null)"
[ -n "$R_DHCP_START" ] || R_DHCP_START="$DHCP_START"
R_DHCP_LIMIT="$(uci -c "$RD" -q get dhcp.lan.limit 2>/dev/null)"
[ -n "$R_DHCP_LIMIT" ] || R_DHCP_LIMIT="$DHCP_LIMIT"
R_DHCP_LEASE="$(uci -c "$RD" -q get dhcp.lan.leasetime 2>/dev/null)"
[ -n "$R_DHCP_LEASE" ] || R_DHCP_LEASE="$DHCP_LEASETIME"
PR="$RADIO_5G_MAX"
PL='5 GHz'
OR="$RADIO_24"
OL='2.4 GHz'
echo "Primary: 5 GHz/$PR (possible DFS delay); backup: 2.4 GHz/$OR."
while true; do
    scan_band "$PR" "$PL"
    radio=$?
    [ "$radio" = 0 ] && break
    [ "$radio" = 2 ] && continue
    echo '1=retry  0=cancel'
    read -r answer
    [ "$answer" = 1 ] || exit 1
done
PSSID="$SEL_SSID"
PENC="$SEL_ENC"
PPASS="$SEL_PASS"
PCHAN="$SEL_CHANNEL"
PAP="$SEL_BSSID"
echo
echo "Selected: $PSSID ($PL ch $PCHAN, $PENC); client APs: $PENC"
BACKUP=0
BSSID=''
BENC=''
BPASS=''
BRAD=''
BCHAN=''
BAP=''
while true; do
    echo
    printf '2.4 backup: 1=same name/key 2=scan another 0=none: '
    read -r bridge_section || break
    case "$bridge_section" in
        1)
            scan_band "$OR" "$OL" "$PSSID" "$PPASS"
            radio=$?
            ;;
        2)
            scan_band "$OR" "$OL"
            radio=$?
            ;;
        0 | '') break ;;
        *) continue ;;
    esac
    [ "$radio" = 0 ] && {
        BACKUP=1
        BRAD="$OR"
        BSSID="$SEL_SSID"
        BENC="$SEL_ENC"
        BPASS="$SEL_PASS"
        BCHAN="$SEL_CHANNEL"
        BAP="$SEL_BSSID"
        echo "Backup: $BSSID ($OL ch $BCHAN, $BENC)"
        break
    }
done
CLIENT_PASS=''
if encryption_needs_key "$PENC"; then
    read_secret "MX4200 client Wi-Fi password for ${PSSID}-RPT (not upstream, 8-63 chars): "
    CLIENT_PASS="$SECRET"
    valid_wifi_password "$CLIENT_PASS" || {
        echo 'Repeater password must be 8-63 characters'
        exit 1
    }
else
    echo "Client Wi-Fi: $PENC (no password)"
fi
MGMT_PASS=''
if [ "$TARGET" = wds ]; then
    echo
    echo "Mgmt AP: ${PSSID}-Management"
    echo "Mgmt IP: $MGMT_IP"
    read_secret 'Separate Management Wi-Fi password (8-63 chars): '
    MGMT_PASS="$SECRET"
    valid_wifi_password "$MGMT_PASS" || {
        echo 'Management password must be 8-63 characters'
        exit 1
    }
fi
wifi_clear
set_option system.@system[0].hostname="$ROUTER_HOSTNAME"
BR="$(find_bridge_section br-lan)"
[ -n "$BR" ] || {
    echo 'br-lan not found'
    exit 1
}
set_option ${BR}.stp=1
uci -q delete "${BR}.ports"
if [ "$TARGET" = wds ]; then
    uci add_list "${BR}.ports=lan2"
    uci add_list "${BR}.ports=lan3"
    configure_bridge_dhcp_client
    set_option "network.lan.metric=$METRIC_PRIMARY_WIFI"
    configure_management_network "$MGMT_IP" "$LAN_NETMASK" "$DHCP_START" lan1 "$R_DHCP_LEASE"
else
    uci add_list "${BR}.ports=lan1"
    uci add_list "${BR}.ports=lan2"
    uci add_list "${BR}.ports=lan3"
    configure_static_lan "$R_LAN_IP" "$R_LAN_NETMASK" "$R_DHCP_START" "$R_DHCP_LIMIT" "$R_DHCP_LEASE"
    uci -q delete network.br_mgmt
    uci -q delete network.mgmt
    uci -q delete dhcp.mgmt
fi
uci -q delete network.usbwan
if [ "$TARGET" = repeater ]; then
    if [ "$WAN_PORT" = lan ]; then
        bridge_wan_port || {
            echo 'Could not add WAN socket to LAN bridge'
            exit 1
        }
    else
        set_option network.wan.device=wan
        set_option network.wan.proto=dhcp
        uci -q delete network.wan6.disabled
    fi
    set_option network.wan.mx_priority="$WAN_PREF"
    for selected_value in wwanp wwanb; do
        set_option network.$selected_value=interface
        set_option network.$selected_value.proto=dhcp
    done
    set_option "network.wwanp.metric=$METRIC_PRIMARY_WIFI"
    set_option "network.wwanb.metric=$METRIC_BACKUP_WIFI"
    [ "$WAN_PREF" = wan ] && set_option "network.wan.metric=$METRIC_WAN_PREFERRED" || set_option "network.wan.metric=$METRIC_WAN_BACKUP"
    uci -q delete network.wdsp
    uci -q delete network.wdsb
else
    set_option network.wan.device=wan
    set_option network.wan.proto=dhcp
    uci -q delete network.wan.mx_priority
    uci -q delete network.wan6.disabled
    for selected_value in wdsp wdsb; do
        set_option network.$selected_value=interface
        set_option network.$selected_value.proto=none
    done
    uci -q delete network.wwanp
    uci -q delete network.wwanb
    set_option "network.wan.metric=$METRIC_WAN_DEFAULT"
fi
sta() {
    section=$1
    radio=$2
    iteration=$3
    ssid=$4
    answer=$5
    encryption=$6
    password=$7
    set_option wireless.$section=wifi-iface
    set_option wireless.$section.device="$radio"
    set_option wireless.$section.mode=sta
    set_option wireless.$section.network="$iteration"
    set_option wireless.$section.ssid="$ssid"
    set_option wireless.$section.bssid="$answer"
    set_option wireless.$section.encryption="$encryption"
    encryption_needs_key "$encryption" && set_option wireless.$section.key="$password"
    [ "$TARGET" = wds ] && set_option wireless.$section.wds=1
    set_option wireless.$section.disabled=0
}
set_option "wireless.$PR.channel=$PCHAN"
sta mx_primary "$PR" "$([ "$TARGET" = wds ] && echo wdsp || echo wwanp)" "$PSSID" "$PAP" "$PENC" "$PPASS"
if [ "$BACKUP" = 1 ]; then
    set_option "wireless.$BRAD.channel=$BCHAN"
    sta mx_backup "$BRAD" "$([ "$TARGET" = wds ] && echo wdsb || echo wwanb)" "$BSSID" "$BAP" "$BENC" "$BPASS"
else
    uci -q delete wireless.mx_backup
    uci -q delete network.wwanb
    uci -q delete network.wdsb
fi
configure_access_point mx_ap5 "$RADIO_5G" lan "${PSSID}-RPT-5G" "$CLIENT_PASS" "$PENC"
configure_access_point mx_ap2 "$RADIO_24" lan "${PSSID}-RPT-2G" "$CLIENT_PASS" "$PENC"
if [ "$TARGET" = wds ]; then
    configure_access_point mx_mgmt "$RADIO_24" mgmt "${PSSID}-Management" "$MGMT_PASS"
else
    uci -q delete wireless.mx_mgmt
fi
delete_firewall_zone mgmt
delete_firewall_zone uplink
ensure_lan_zone
configure_wan_zone
WZ="$(find_firewall_zone wan)"
[ -n "$WZ" ] && {
    for iteration in wan lan wwan wwanp wwanb usbwan; do
        uci -q del_list "${WZ}.network=$iteration"
    done
    uci add_list "${WZ}.network=wan"
    [ "$TARGET" = wds ] && uci add_list "${WZ}.network=lan"
}
uci -q delete firewall.mx_wan_lan
if [ "$TARGET" = wds ]; then
    delete_firewall_zone lan
    uci -q delete firewall.mx_mgmt_wan
    configure_management_firewall
    ensure_forwarding mgmt wan
else
    configure_uplink_zone
    delete_non_vpn_forwardings lan
    delete_non_vpn_forwardings uplink
    ensure_forwarding lan uplink
    ensure_forwarding lan wan
    configure_management_rule wan
    configure_management_rule uplink
fi
commit_mode_configuration
echo "$TARGET" >/etc/mx4200/mode
save_profile "$TARGET"
prompt_auto_priority "$TARGET"
reload_mode_services
echo
echo 'Applied; Wi-Fi may reconnect.'
sleep 10
/usr/sbin/mxm status
[ "$TARGET" = wds ] && {
    echo
    /root/mxwds 2>/dev/null || true
    echo
    echo 'WDS DHCP/DNS: upstream'
    echo "Mgmt Wi-Fi: ${PSSID}-Management"
    echo "Mgmt IP: $(uci -q get network.mgmt.ipaddr)"
}
